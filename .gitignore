# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.log
*.jks
*.keystore
keystore.properties

# IDE and machine-local project state
/.idea/
*.iml

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

# Android/Gradle generated files and local configuration
/android/.gradle/
/android/.kotlin/
/android/**/build/
/android/**/.cxx/
/android/**/.externalNativeBuild/
/android/captures/
/android/local.properties
*.apk
*.aab
*.aar
*.ap_
*.dex
*.class

# Android device/emulator inspection artifacts kept only on the local machine
/android/*.png
/android/*.xml

# Local runtime and test artifacts
/logs/
/tmp/
__pycache__/
*.py[cod]
/.pytest_cache/

# Local conversation records: contain deployment configuration guidance and must
# remain local; never commit them to the repository.
/docs/conversation/lanerc-android-ci-build-upload-qa.md
/docs/conversation/lanerc-cloud-config-qa.md
