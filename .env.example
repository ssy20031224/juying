# Cloudflare Worker + D1 account service
ACCOUNT_AUTH_ENABLED=true
COMMENTS_POSTING_ENABLED=true
COMMENTS_REQUIRE_ACCOUNT=true
# Generate a stable random secret of at least 32 characters. Never expose it to Android.
AUTH_CODE_PEPPER=

# Aliyun DirectMail verification email
ALIYUN_DM_ACCESS_KEY_ID=
ALIYUN_DM_ACCESS_KEY_SECRET=
ALIYUN_DM_ACCOUNT_NAME=
ALIYUN_DM_FROM_ALIAS=聚映

# Aliyun OSS avatar storage and optional comment fallback
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_PUBLIC_BASE_URL=
COMMENTS_OSS_PREFIX=comments
COMMENTS_PUBLIC_BASE_URL=
